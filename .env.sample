# This is documentation, not an automatically loaded configuration file.
# Copy to .env only for local use and export variables in your shell/process.
# Set production secrets in the deployment's secure app environment.

# Server configuration
PORT=4100

# Data directory for SQLite database
DATA_DIR=.

# Required runtime secrets. Never commit populated values.
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
ADMIN_SECRET=

# Non-secret Polar product identifiers for your own account.
POLAR_PERSONAL_PRODUCT_ID=
POLAR_BUSINESS_PRODUCT_ID=
POLAR_ENTERPRISE_PRODUCT_ID=
